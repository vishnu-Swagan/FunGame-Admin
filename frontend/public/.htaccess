Options -MultiViews
RewriteEngine On
RewriteBase /admin/

# Keep real static assets and files cacheable; route only client-side paths to
# the React entry point so direct links such as /admin/users keep working.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.html [L]
