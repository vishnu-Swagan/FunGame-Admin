# Copy to .env for local runs, or set these as environment variables on your host.

# --- Required ---
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=fungame

# --- Recommended ---
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=*

# --- Contact verification / password-reset OTPs ---
APP_ENV=development
# Set OTP_PEPPER to a different random value of at least 32 characters. It is
# mandatory in production and must remain in the host's secret manager.
OTP_PEPPER=

# Delivery is disabled until an adapter is explicitly configured. The `mock`
# adapter and OTP_EXPOSE_DEV_CODE=true are local/test conveniences only and are
# rejected in production. Never commit a real OTP pepper or provider secret.
OTP_EMAIL_ADAPTER=disabled
OTP_SMS_ADAPTER=disabled
OTP_EXPOSE_DEV_CODE=false

# Email: set OTP_EMAIL_ADAPTER=email_service and configure one real provider.
EMAIL_PROVIDER=disabled
# For Resend:
# RESEND_API_KEY=
# SENDER_EMAIL=onboarding@resend.dev

# SMS: set OTP_SMS_ADAPTER=twilio and store all values as host secrets.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Financial core (all money paths are OFF until explicitly approved) ---
# Enabling any sub-feature without a ready transaction-capable MongoDB,
# provider adapter, encryption keys, jurisdiction list, and gameplay bucket
# integration keeps /health fail-closed at 503.
REAL_MONEY_ENABLED=false
DEPOSITS_ENABLED=false
WITHDRAWALS_ENABLED=false
AUTO_WITHDRAWALS_ENABLED=false
FINANCIAL_GAME_WALLET_INTEGRATED=false

# The bundled mock is local/test only and is rejected when APP_ENV=production.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Production value: https://chakri.casino/chips/deposit/return
PAYMENT_RETURN_URL=http://localhost:3000/chips/deposit/return

# Integer, versioned conversion. INR is stored as integer paise.
CHIPS_PER_INR=1
CHIP_RATE_VERSION=v1
MIN_DEPOSIT_PAISE=10000
MAX_DEPOSIT_PAISE=100000000
# Releases an abandoned pre-checkout deposit-limit reservation after 30 min.
DEPOSIT_CHECKOUT_RESERVATION_TTL_SECONDS=1800
# Poll credited deposits daily for late refunds/chargebacks for 120 days.
DEPOSIT_REFUND_RECONCILIATION_DAYS=120
DEPOSIT_REFUND_RECONCILE_SECONDS=86400
MIN_WITHDRAWAL_CHIPS=500
MAX_WITHDRAWAL_CHIPS=1000000

# Generate two different 32-byte values and base64-url encode them. Never
# commit real keys. Retain retired PAYOUT_DATA_KEY_<VERSION> values so old bank
# records remain decryptable after rotation.
PAYOUT_DATA_ACTIVE_KEY_VERSION=v1
PAYOUT_DATA_KEY_V1=
PAYOUT_DATA_FINGERPRINT_KEY=

# Comma-separated ISO alpha-2 registrations eligible for financial services.
FINANCIAL_ALLOWED_COUNTRIES=
ADMIN_FINANCIAL_STEP_UP_SECONDS=300
