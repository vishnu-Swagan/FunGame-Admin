# Copy to .env for local runs, or set these as environment variables on your host.

# --- Required ---
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=fungame

# --- Recommended ---
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=*

# --- Contact verification / password-reset OTPs ---
APP_ENV=development
# Set OTP_PEPPER to a different random value of at least 32 characters. It is
# mandatory in production and must remain in the host's secret manager.
OTP_PEPPER=

# Temporary launch mode: collect both contacts and hold the account for an
# administrator decision. Switch to PHONE_OTP only after an approved SMS
# provider is configured and tested.
REGISTRATION_MODE=ADMIN_REVIEW

# Delivery is disabled until an adapter is explicitly configured. The `mock`
# adapter and OTP_EXPOSE_DEV_CODE=true are local/test conveniences only and are
# rejected in production. Never commit a real OTP pepper or provider secret.
OTP_EMAIL_ADAPTER=disabled
OTP_SMS_ADAPTER=disabled
OTP_EXPOSE_DEV_CODE=false
# Require a fresh one-time code after a player proves their password. Admin and
# distributor portals retain their existing step-up policies.
PLAYER_LOGIN_OTP_REQUIRED=false

# Email: set OTP_EMAIL_ADAPTER=email_service and configure one real provider.
EMAIL_PROVIDER=disabled
# For Resend:
# RESEND_API_KEY=
# SENDER_EMAIL=onboarding@resend.dev

# SMS: set OTP_SMS_ADAPTER=telesign (or twilio) and store all credentials as
# host secrets. Telesign SMS Verify uses an application-generated code.
# OTP_SMS_ADAPTER=telesign_verify calls verify.telesign.com (Unified Verify).
# HTTP 401 + status 3906 means that product is not enabled; self-service
# accounts should use OTP_SMS_ADAPTER=telesign (SMS Verify) instead, or keep
# telesign_verify and let the adapter fall back to SMS Verify automatically.
TELESIGN_CUSTOMER_ID=
TELESIGN_API_KEY=
# Product access and product usage are separate. Enable paid calls deliberately.
TELESIGN_PLAN=self-service
# disabled | observe | enforce. Intelligence is used for onboarding when Verify
# Plus is not already screening the OTP, and for successful-password sign-ins.
TELESIGN_INTELLIGENCE_MODE=disabled
# disabled | observe | enforce. Contact PII is discarded; only add-on status and
# standard phone metadata are retained for the Admin review record.
TELESIGN_PHONE_ID_MODE=disabled
TELESIGN_CONTACT_ADDON_ENABLED=false
# Verify Plus is activated and tuned in My Telesign. When true, the app avoids
# a duplicate Intelligence charge during SMS Verify onboarding.
TELESIGN_VERIFY_PLUS_ENABLED=false
# Reserved for consented transactional engagement; never enables bulk marketing.
TELESIGN_ENGAGEMENT_SMS_ENABLED=false

# Twilio alternative:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Financial core (all money paths are OFF until explicitly approved) ---
# Enabling any sub-feature without a ready transaction-capable MongoDB,
# provider adapter, encryption keys, jurisdiction list, and gameplay bucket
# integration keeps /health fail-closed at 503.
REAL_MONEY_ENABLED=false
DEPOSITS_ENABLED=false
WITHDRAWALS_ENABLED=false
AUTO_WITHDRAWALS_ENABLED=false
FINANCIAL_GAME_WALLET_INTEGRATED=false

# Promotion rollout is independently fail-closed. Regulatory approval is not a
# deployment toggle: set it only after jurisdiction-specific legal sign-off,
# versioned terms, game-wallet certification and an operator launch review.
REGULATORY_APPROVED=false
WAGER_MISSIONS_ENABLED=false
REFERRAL_REWARDS_ENABLED=false
PROMOTIONS_GAME_WALLET_INTEGRATED=false
# External certification must name the exact runtime settlement-finality
# policy. Keep all three values fail-closed until independent certification.
WAGER_SETTLEMENT_FINALITY_CERTIFIED=false
WAGER_SETTLEMENT_FINALITY_POLICY_VERSION=
WAGER_SETTLEMENT_FINALITY_CERTIFIED_POLICY_VERSION=
RANDOMIZED_REWARDS_LEGAL_APPROVED=false
# Exact trusted app origin used for generated invite links. Production requires
# HTTPS with no credentials, path, query, fragment or custom port.
PROMOTIONS_PUBLIC_APP_ORIGIN=http://localhost:3000
# Independent 32+ character HMAC secret for non-reversible referral risk
# clusters. Never reuse a provider, OTP or payout encryption secret.
REFERRAL_RISK_PEPPER=

# Retired manual play-chip request/approval workflow. Historical rows remain
# readable for audit; request and resolution mutations are disabled by default.
LEGACY_CHIP_REQUESTS_ENABLED=false

# Immutable legal-policy versions shown during registration. Publish each
# version at a stable URL before enabling explicit acknowledgement. Historical
# acceptance records retain the exact metadata and hashes captured at signup.
CURRENT_TERMS_VERSION=legacy-account-terms-v1
CURRENT_PRIVACY_VERSION=legacy-privacy-notice-v1
TERMS_PUBLIC_URL=
PRIVACY_PUBLIC_URL=
TERMS_EFFECTIVE_AT=
PRIVACY_EFFECTIVE_AT=
TERMS_CONTENT_SHA256=
PRIVACY_CONTENT_SHA256=
# Migration bridge for the existing single-checkbox registration client. Set
# true after every supported client submits accepted_privacy plus both current
# version identifiers; stale versions are always rejected even in bridge mode.
POLICY_EXPLICIT_VERSION_ACK_REQUIRED=false

# Universal payment gateway administration.
# Production render.yaml turns PAYMENT_GATEWAY_ADMIN_ENABLED on so CRM can add
# gateways. Keep PAYMENTS_V2_ENABLED false until wallet posting is certified.
PAYMENTS_V2_ENABLED=false
PAYMENT_GATEWAY_ADMIN_ENABLED=false
PAYMENT_LIVE_MODE_ALLOWED=false
# URL-safe base64 encoded 32-byte AES-GCM key. Store only in the host secret manager.
PAYMENT_CREDENTIALS_MASTER_KEY=
# Public HTTPS origin used to display provider webhook URLs. Production: https://api.chakri.casino
PAYMENT_WEBHOOK_PUBLIC_BASE_URL=
PAYMENT_HTTP_CONNECT_TIMEOUT_MS=5000
PAYMENT_HTTP_REQUEST_TIMEOUT_MS=15000
PAYMENT_HTTP_MAX_RESPONSE_BYTES=1048576
PAYMENT_WEBHOOK_REPLAY_WINDOW_SECONDS=300
PAYMENT_RETRY_MAX_ATTEMPTS=5
PAYMENT_RETRY_BASE_DELAY_SECONDS=5
PAYMENT_OUTBOX_BATCH_SIZE=100
PAYMENT_GATEWAY_HEALTH_INTERVAL_SECONDS=60
PAYMENT_STATUS_POLL_INTERVAL_SECONDS=60
PAYMENT_PROVIDER_ALLOWED_DOMAINS=
PAYMENT_PROVIDER_CHECKOUT_ALLOWED_DOMAINS=
PAYMENT_ALERT_COOLDOWN_SECONDS=900

# Legacy wallet bridge: no provider default exists. Configure only from the
# provider's signed merchant contract; credential values belong in host secrets.
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_CONFIG_JSON=
PAYMENT_PROVIDER_API_TOKEN=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_USERNAME=
PAYMENT_PROVIDER_PASSWORD=
PAYMENT_PROVIDER_HMAC_SECRET=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
# Production value: https://chakri.casino/wallet/deposit/return
PAYMENT_RETURN_URL=http://localhost:3000/wallet/deposit/return

# Integer, versioned conversion. INR is stored as integer paise.
CHIPS_PER_INR=1
CHIP_RATE_VERSION=v1
MIN_DEPOSIT_PAISE=10000
MAX_DEPOSIT_PAISE=100000000
# Releases an abandoned pre-checkout deposit-limit reservation after 30 min.
DEPOSIT_CHECKOUT_RESERVATION_TTL_SECONDS=1800
# Poll credited deposits daily for late refunds/chargebacks for 120 days.
DEPOSIT_REFUND_RECONCILIATION_DAYS=120
DEPOSIT_REFUND_RECONCILE_SECONDS=86400
# INR 1,000 in paise. This non-reducible currency floor is enforced after chip
# conversion, independently of CHIPS_PER_INR.
MIN_WITHDRAWAL_PAISE=100000
# Secondary chip-unit bounds retained for operational safety.
MIN_WITHDRAWAL_CHIPS=500
MAX_WITHDRAWAL_CHIPS=1000000

# Optional dedicated 32-byte keys (base64-url). If empty, operator-rail bank
# details derive AES keys from PAYMENT_CREDENTIALS_MASTER_KEY so Admin→SgPay
# payouts work without the unused WITHDRAWALS_ENABLED rail. Never commit real
# keys. Retain retired PAYOUT_DATA_KEY_<VERSION> values after rotation.
PAYOUT_DATA_ACTIVE_KEY_VERSION=v1
PAYOUT_DATA_KEY_V1=
PAYOUT_DATA_FINGERPRINT_KEY=

# Comma-separated ISO alpha-2 registrations eligible for financial services.
FINANCIAL_ALLOWED_COUNTRIES=
ADMIN_FINANCIAL_STEP_UP_SECONDS=300

# Live player cash-out is Admin approve then SgPay24 send (operator rail).
# Keep WITHDRAWALS_ENABLED false; that flag is the unused financial-wallet rail.
SGPAY24_PAYOUTS_ENABLED=true
SGPAY24_PAYOUT_PATH=/api/createPayoutRequest
