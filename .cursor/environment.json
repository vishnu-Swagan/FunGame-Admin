{
  "name": "Chakri.Casino (FastAPI + MongoDB + React)",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && ./.venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000"
    },
    {
      "name": "frontend",
      "command": "cd frontend && yarn craco start"
    }
  ],
  "ports": [
    { "name": "backend", "port": 8000 },
    { "name": "frontend", "port": 3000 }
  ]
}
